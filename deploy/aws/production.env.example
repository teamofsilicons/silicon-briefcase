# Copy to production.env and fill in. This file names shared infrastructure;
# it holds no credentials — those live in Secrets Manager, and the Namecheap
# key is read from your environment or added here and kept out of git.

AWS_REGION=us-east-1

# The shared Team of Silicons network and load balancer, the same ones Silicon
# IAM sits behind. Find them with:
#   aws elbv2 describe-load-balancers --query 'LoadBalancers[].{Name:LoadBalancerName,Arn:LoadBalancerArn,Vpc:VpcId}'
#   aws elbv2 describe-listeners --load-balancer-arn <arn> --query 'Listeners[?Port==`443`].ListenerArn'
BRIEFCASE_VPC_ID=vpc-
BRIEFCASE_PRIVATE_SUBNET_A=subnet-
BRIEFCASE_PRIVATE_SUBNET_B=subnet-
BRIEFCASE_ALB_SECURITY_GROUP_ID=sg-
BRIEFCASE_HTTPS_LISTENER_ARN=arn:aws:elasticloadbalancing:us-east-1:000000000000:listener/app/.../...

# An ACM certificate covering backend.briefcase.teamofsilicons.com, validated
# by a DNS record at Namecheap.
BRIEFCASE_CERTIFICATE_ARN=arn:aws:acm:us-east-1:000000000000:certificate/...

# Secrets Manager secret holding the application credentials; see deploy/README.md.
BRIEFCASE_APP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:000000000000:secret:silicon-briefcase/production-...

BRIEFCASE_PUBLIC_HOST=backend.briefcase.teamofsilicons.com
# Must not collide with another service's rule on the shared HTTPS listener.
BRIEFCASE_LISTENER_RULE_PRIORITY=30

# Namecheap, for ./deploy/dns.sh. The calling machine's public IP must be on
# the API allow list at Profile > Tools > Namecheap API Access.
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_DOMAIN=teamofsilicons.com
