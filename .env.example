BRIEFCASE_ENVIRONMENT=development
BRIEFCASE_BIND_ADDR=127.0.0.1:4101
BRIEFCASE_PUBLIC_BASE_URL=http://127.0.0.1:4101/api/v1/
BRIEFCASE_PUBLIC_SITE_BASE_URL=http://localhost:4100/
BRIEFCASE_REQUEST_TIMEOUT_SECONDS=15
BRIEFCASE_UPLOAD_TIMEOUT_SECONDS=900
BRIEFCASE_RESTORE_TIMEOUT_SECONDS=172800
BRIEFCASE_MAX_JSON_BODY_BYTES=1048576
BRIEFCASE_MAX_CONCURRENT_REQUESTS=1024
BRIEFCASE_MAX_CONCURRENT_RESTORES=2
BRIEFCASE_SHUTDOWN_TIMEOUT_SECONDS=30

BRIEFCASE_DATABASE_URL=postgres://briefcase_api:briefcase-api-local-only@127.0.0.1:5433/briefcase
BRIEFCASE_DATABASE_MAX_CONNECTIONS=24
BRIEFCASE_DATABASE_MIN_CONNECTIONS=1
BRIEFCASE_DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
BRIEFCASE_DATABASE_STATEMENT_TIMEOUT_SECONDS=10
BRIEFCASE_WORKER_DATABASE_URL=postgres://briefcase_worker:briefcase-worker-local-only@127.0.0.1:5433/briefcase
BRIEFCASE_MIGRATOR_DATABASE_URL=postgres://briefcase:briefcase-local-only@127.0.0.1:5433/briefcase
BRIEFCASE_MIGRATOR_DATABASE_MAX_CONNECTIONS=2
BRIEFCASE_MIGRATOR_DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
BRIEFCASE_MIGRATOR_DATABASE_STATEMENT_TIMEOUT_SECONDS=120

# Silicon Accounts. ACCOUNTS_URL is the public origin and the `iss` of every
# access token; ACCOUNTS_API_URL (optional) is where Briefcase calls it server
# to server. Plain http is accepted only for this machine. Production:
# ACCOUNTS_URL=https://accounts.teamofsilicons.com and no ACCOUNTS_API_URL.
ACCOUNTS_URL=http://localhost:9590
ACCOUNTS_API_URL=http://127.0.0.1:9589
BRIEFCASE_APP_ID=briefcase
# The app secret from Silicon Apps (sa_app_...). Server only; never give it to the CLI or the web browser.
BRIEFCASE_APP_SECRET=sa_app_replace_with_the_briefcase_app_secret
BRIEFCASE_ACCOUNTS_REQUEST_TIMEOUT_MS=5000
BRIEFCASE_ACCOUNT_CACHE_TTL_SECONDS=300

# Webhook signing secret (whsec_...) returned when the webhook URL
# https://backend.briefcase.teamofsilicons.com/webhook/ is set at Silicon Accounts.
BRIEFCASE_ACCOUNTS_WEBHOOK_SECRET=whsec_replace_with_the_briefcase_webhook_secret
# During a rotation, keep the old secret here until deliveries use the new one.
# BRIEFCASE_ACCOUNTS_WEBHOOK_PREVIOUS_SECRET=whsec_...
BRIEFCASE_WEBHOOK_MAX_BODY_BYTES=262144

# Which apps may act for an account through /api/v1/obo/* with a User
# verification proof, per scope: `scope=app` or `scope=app1|app2`, separated by
# commas or spaces. Unset means no app may (deny by default). Production value:
# see docs/migration/decisions.md (waveform, extend, browser, interface).
# BRIEFCASE_PROOF_ISSUERS=briefcase.uploads.reserve=waveform|extend briefcase.uploads.commit=waveform|extend
# Apps above that reach everything the account can (its own drive, what was
# shared with it, the drives of the Silicons it looks after) instead of only
# their own apps/{app}/ folder. Unset means none. Production: interface.
# BRIEFCASE_PROOF_FIRST_PARTY_ISSUERS=interface

BRIEFCASE_S3_REGION=us-east-1
BRIEFCASE_S3_BUCKET=briefcase-local
BRIEFCASE_S3_KEY_PREFIX=organizations
BRIEFCASE_S3_ENDPOINT_URL=http://127.0.0.1:9000
BRIEFCASE_S3_FORCE_PATH_STYLE=true
BRIEFCASE_S3_ENCRYPTION_MODE=sse_s3
BRIEFCASE_S3_OPERATION_TIMEOUT_SECONDS=1800
BRIEFCASE_TEMPORARY_DIRECTORY=/tmp/silicon-briefcase
AWS_ACCESS_KEY_ID=briefcase-local
AWS_SECRET_ACCESS_KEY=briefcase-local-secret

BRIEFCASE_WORKER_BATCH_SIZE=100
BRIEFCASE_WORKER_CLEANUP_CONCURRENCY=4
BRIEFCASE_WORKER_POLL_INTERVAL_MS=500
BRIEFCASE_WORKER_LEASE_SECONDS=60
BRIEFCASE_WORKER_MAX_ATTEMPTS=20
BRIEFCASE_WORKER_MAX_RETRY_DELAY_SECONDS=300
BRIEFCASE_WORKER_MAINTENANCE_INTERVAL_SECONDS=60

BRIEFCASE_LOG_FILTER=silicon_briefcase=debug,tower_http=info

# Required on the worker for production invitation email. Verify this sender in Postmark.
# BRIEFCASE_POSTMARK_SERVER_TOKEN=...
# Sender: briefcase@teamofsilicons.com.
