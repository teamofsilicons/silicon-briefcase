BRIEFCASE_ENVIRONMENT=development
BRIEFCASE_BIND_ADDR=127.0.0.1:8080
BRIEFCASE_PUBLIC_BASE_URL=http://127.0.0.1:8080/api/v1/
BRIEFCASE_CDN_BASE_URL=http://127.0.0.1:8080/downloads/
BRIEFCASE_REQUEST_TIMEOUT_SECONDS=15
BRIEFCASE_UPLOAD_TIMEOUT_SECONDS=900
BRIEFCASE_RESTORE_TIMEOUT_SECONDS=172800
BRIEFCASE_MAX_JSON_BODY_BYTES=1048576
BRIEFCASE_MAX_CONCURRENT_REQUESTS=1024
BRIEFCASE_MAX_CONCURRENT_RESTORES=2
BRIEFCASE_SHUTDOWN_TIMEOUT_SECONDS=30

BRIEFCASE_DATABASE_URL=postgres://briefcase_api:briefcase-api-local-only@127.0.0.1:5433/briefcase
BRIEFCASE_DATABASE_MAX_CONNECTIONS=24
BRIEFCASE_DATABASE_MIN_CONNECTIONS=1
BRIEFCASE_DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
BRIEFCASE_DATABASE_STATEMENT_TIMEOUT_SECONDS=10
BRIEFCASE_WORKER_DATABASE_URL=postgres://briefcase_worker:briefcase-worker-local-only@127.0.0.1:5433/briefcase
BRIEFCASE_MIGRATOR_DATABASE_URL=postgres://briefcase:briefcase-local-only@127.0.0.1:5433/briefcase
BRIEFCASE_MIGRATOR_DATABASE_MAX_CONNECTIONS=2
BRIEFCASE_MIGRATOR_DATABASE_ACQUIRE_TIMEOUT_SECONDS=10
BRIEFCASE_MIGRATOR_DATABASE_STATEMENT_TIMEOUT_SECONDS=120

BRIEFCASE_IAM_BASE_URL=http://127.0.0.1:8081/api/v1/
BRIEFCASE_IAM_BEARER_INTROSPECTION_PATH=auth/tokens/introspect
BRIEFCASE_IAM_USERINFO_PATH=oauth/userinfo
BRIEFCASE_IAM_OBO_VERIFICATION_PATH=obo-access/verify
BRIEFCASE_IAM_APP_ID=silicon-briefcase
BRIEFCASE_IAM_APP_SECRET=local-iam-secret-change-me-0000000000000000
BRIEFCASE_IAM_AUDIENCE=silicon-briefcase
BRIEFCASE_IAM_CONNECT_TIMEOUT_MS=500
BRIEFCASE_IAM_REQUEST_TIMEOUT_MS=2000
BRIEFCASE_IAM_MAX_RESPONSE_BYTES=1048576

BRIEFCASE_IAM_WEBHOOK_SIGNING_SECRET=local-webhook-secret-change-me-000000000000
BRIEFCASE_IAM_WEBHOOK_KEY_VERSION=1
BRIEFCASE_IAM_WEBHOOK_REPLAY_WINDOW_SECONDS=300
BRIEFCASE_IAM_WEBHOOK_MAX_BODY_BYTES=262144

BRIEFCASE_S3_REGION=us-east-1
BRIEFCASE_S3_BUCKET=briefcase-local
BRIEFCASE_S3_KEY_PREFIX=organizations
BRIEFCASE_S3_ENDPOINT_URL=http://127.0.0.1:9000
BRIEFCASE_S3_FORCE_PATH_STYLE=true
BRIEFCASE_S3_ENCRYPTION_MODE=sse_s3
BRIEFCASE_S3_OPERATION_TIMEOUT_SECONDS=1800
BRIEFCASE_TEMPORARY_DIRECTORY=/tmp/silicon-briefcase
AWS_ACCESS_KEY_ID=briefcase-local
AWS_SECRET_ACCESS_KEY=briefcase-local-secret

BRIEFCASE_WORKER_BATCH_SIZE=100
BRIEFCASE_WORKER_CLEANUP_CONCURRENCY=4
BRIEFCASE_WORKER_POLL_INTERVAL_MS=500
BRIEFCASE_WORKER_LEASE_SECONDS=60
BRIEFCASE_WORKER_MAX_ATTEMPTS=20
BRIEFCASE_WORKER_MAX_RETRY_DELAY_SECONDS=300
BRIEFCASE_WORKER_MAINTENANCE_INTERVAL_SECONDS=60

BRIEFCASE_LOG_FILTER=silicon_briefcase=debug,tower_http=info
